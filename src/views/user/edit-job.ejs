<!DOCTYPE html>
<html lang="tr">
<head>
  <%- include('../partials/head', { title: 'İlan Düzenle - Bingöl Plus', description: 'Bingöl Plus iş ilanı düzenleme sayfası. Yayınladığınız ilanı güncelleyin.' }) %>
  <title>İlan Düzenle - Bingöl Plus</title>
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>

  <%- include('../partials/navbar', { currentPage: 'profilim' }) %>

  <div class="auth-wrap">
    <%- include('../partials/flash') %>
    <div class="auth-card auth-card-wide">
      <a href="/profilim" class="top-link" style="margin-bottom:16px;">← Profilime Dön</a>
      <h1>İlanı Düzenle</h1>
      <p class="auth-sub"><%= job.title %></p>

      <form id="job-form" action="/ilanlar/duzenle/<%= job.id %>" method="POST" autocomplete="off" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
          <label for="title">İlan Başlığı <span style="color:var(--clay);">*</span></label>
          <input type="text" id="title" name="title" placeholder="Örn: Satış Danışmanı" data-required="true" value="<%= job.title %>">
          <div class="field-error" id="title-error"><%= (locals.flash && locals.flash.errors && locals.flash.errors.title) ? locals.flash.errors.title : '' %></div>
        </div>

        <div class="form-group">
          <label for="company">Şirket Adı <span style="color:var(--clay);">*</span></label>
          <input type="text" id="company" name="company" placeholder="Örn: Bingöl Ticaret A.Ş." data-required="true" value="<%= job.company %>">
          <div class="field-error" id="company-error"><%= (locals.flash && locals.flash.errors && locals.flash.errors.company) ? locals.flash.errors.company : '' %></div>
        </div>

        <div class="form-group">
          <label for="location">İl/İlçe <span style="color:var(--clay);">*</span></label>
          <input type="text" id="location" name="location" placeholder="Örn: Bingöl Merkez" data-required="true" value="<%= job.location %>">
          <div class="field-error" id="location-error"><%= (locals.flash && locals.flash.errors && locals.flash.errors.location) ? locals.flash.errors.location : '' %></div>
        </div>

        <div class="form-group">
          <label for="phone">İletişim (Telefon Numarası)</label>
          <input type="text" id="phone" name="phone" placeholder="Örn: 0500 000 00 00" data-type="phone" value="<%= job.phone || '' %>">
          <div class="field-error" id="phone-error"><%= (locals.flash && locals.flash.errors && locals.flash.errors.phone) ? locals.flash.errors.phone : '' %></div>
        </div>

        <div class="form-group">
          <label for="type">Çalışma Şekli</label>
          <select id="type" name="type">
            <option value="">Seçiniz</option>
            <option value="Tam Zamanlı" <%= job.type === 'Tam Zamanlı' ? 'selected' : '' %>>Tam Zamanlı</option>
            <option value="Yarı Zamanlı" <%= job.type === 'Yarı Zamanlı' ? 'selected' : '' %>>Yarı Zamanlı</option>
            <option value="Sözleşmeli" <%= job.type === 'Sözleşmeli' ? 'selected' : '' %>>Sözleşmeli</option>
            <option value="Stajyer" <%= job.type === 'Stajyer' ? 'selected' : '' %>>Stajyer</option>
            <option value="Staj" <%= job.type === 'Staj' ? 'selected' : '' %>>Staj</option>
            <option value="Proje Bazlı" <%= job.type === 'Proje Bazlı' ? 'selected' : '' %>>Proje Bazlı</option>
          </select>
        </div>

        <div class="form-group">
          <label for="salary">Maaş</label>
          <input type="text" id="salary" name="salary" placeholder="Örn: 25.000 - 30.000" value="<%= job.salary || '' %>">
          <div class="field-error" id="salary-error"><%= (locals.flash && locals.flash.errors && locals.flash.errors.salary) ? locals.flash.errors.salary : '' %></div>
        </div>

        <div class="form-group">
          <label for="description">İş Açıklaması <span style="color:var(--clay);">*</span></label>
          <textarea id="description" name="description" placeholder="İşin detaylarını, gereklilikleri ve firma hakkında bilgileri yazın..." rows="6" data-required="true"><%= job.description %></textarea>
          <div class="field-error" id="description-error"><%= (locals.flash && locals.flash.errors && locals.flash.errors.description) ? locals.flash.errors.description : '' %></div>
        </div>

        <button type="submit" class="btn btn-solid auth-btn">Değişiklikleri Kaydet</button>
      </form>

      <script src="/js/app.js"></script>
    </div>
  </div>

  <%- include('../partials/footer') %>

</body>
</html>