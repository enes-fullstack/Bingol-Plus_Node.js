<!DOCTYPE html>
<html lang="tr">

<head>
  <%- include('../partials/head', { title: 'Profilim - Bingöl Plus', description: 'Bingöl Plus profil sayfası. Kaydettiğiniz ilanları görüntüleyin ve profil bilgilerinizi düzenleyin.' }) %>
  <title>Profilim - Bingöl Plus</title>
  <link rel="stylesheet" href="/vendor/cropper/cropper.min.css">
  <link rel="stylesheet" href="/css/profile.css">
</head>

<body data-user-logged-in="<%= typeof userId !== 'undefined' && userId ? 'true' : 'false' %>">

  <%- include('../partials/navbar', { currentPage: 'profilim' }) %>

  <div class="wrap">
    <%- include('../partials/flash') %>
    <div class="crumb">
      <a href="/">Ana Sayfa</a>
      <span>/</span>
      <span class="mono">Profilim</span>
    </div>
    <a href="/" class="top-link">← Ana Sayfaya Dön</a>

    <main>
      <div class="profile-head">
        <% if (user.profileImage) { %>
          <span class="avatar-wrap" data-avatar="<%= user.profileImage %>">
            <img src="<%= user.profileImage.replace('/upload/', '/upload/w_64,h_64,c_fill,f_auto,q_auto/') %>" alt="" class="avatar-img" loading="lazy">
            <div class="avatar-big <%= user.role === 'admin' ? 'admin-avatar' : '' %> avatar-fallback" style="display:none" aria-hidden="true"><%= user.username.charAt(0).toUpperCase() %></div>
          </span>
        <% } else { %>
          <div class="avatar-big <%= user.role === 'admin' ? 'admin-avatar' : '' %>"><%= user.username.charAt(0).toUpperCase() %></div>
        <% } %>
        <div style="flex:1;">
          <h1 class="<%= user.role === 'admin' ? 'admin-username' : '' %>" style="display:inline-flex;align-items:center;gap:0;"><%= user.username %><% if (user.role === 'admin') { %><span class="admin-tick" title="Doğrulanmış Admin" aria-label="Doğrulanmış Admin"><span class="admin-tick-outer" aria-hidden="true"><svg viewBox="0 0 100 100" class="admin-tick-gear" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M98 50 L79.42 55.85 L94.35 68.37 L74.94 66.67 L83.94 83.94 L66.67 74.94 L68.37 94.35 L55.85 79.42 L50 98 L44.15 79.42 L31.63 94.35 L33.33 74.94 L16.06 83.94 L25.06 66.67 L5.65 68.37 L20.58 55.85 L2 50 L20.58 44.15 L5.65 31.63 L25.06 33.33 L16.06 16.06 L33.33 25.06 L31.63 5.65 L44.15 20.58 L50 2 L55.85 20.58 L68.37 5.65 L66.67 25.06 L83.94 16.06 L74.94 33.33 L94.35 31.63 L79.42 44.15 Z"/></svg></span><span class="admin-tick-inner"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M8.2 12.4l2.8 2.8 5.8-5.8" stroke="white" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span></span><% } %></h1>
          <div class="email"><%= user.email %></div>
        </div>
        <form id="avatar-form" action="/profilim/resim-yukle" method="POST" enctype="multipart/form-data" style="display:flex;flex-direction:column;align-items:center;gap:8px;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label for="avatar-input" class="btn btn-ghost btn-sm" style="cursor:pointer;">Profil Resmi Seç</label>
          <input type="file" id="avatar-input" name="profileImage" accept="image/jpeg,image/png,image/webp" style="display:none;">
          <div id="avatar-preview" style="display:none;"></div>
          <button type="submit" id="avatar-submit" class="btn btn-solid btn-sm" style="display:none;">Yükle</button>
          <div id="avatar-error" class="field-error" style="text-align:center;"></div>
        </form>
      </div>

      <div class="stat-grid">
        <div class="stat-card">
          <label>Kayıt Tarihi</label>
          <span><%= new Date(user.createdAt).toLocaleDateString("tr-TR", { year: "numeric", month: "long", day: "numeric" }) %></span>
        </div>
        <div class="stat-card">
          <label>Açılan Konu Sayısı</label>
          <span class="mono"><%= postCount %></span>
        </div>
      </div>

      <div class="profile-nav-cards">
        <a href="/profilim/postlarim" class="profile-nav-card">
          <div class="pnc-top">
            <span class="pnc-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
            </span>
            <span class="pnc-count mono"><%= postCount %></span>
          </div>
          <h3>Postlarım</h3>
          <p>Paylaştığınız gönderileri görüntüleyin ve silin</p>
          <span class="pnc-link">Görüntüle →</span>
        </a>

        <a href="/profilim/kaydedilen-postlar" class="profile-nav-card">
          <div class="pnc-top">
            <span class="pnc-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path><path d="M9 10h6"/><path d="M9 14h6"/></svg>
            </span>
            <span class="pnc-count mono"><%= typeof savedPostCount !== 'undefined' ? savedPostCount : 0 %></span>
          </div>
          <h3>Kaydedilen Postlar</h3>
          <p>Kaydettiğiniz forum gönderilerini görüntüleyin</p>
          <span class="pnc-link">Görüntüle →</span>
        </a>

        <a href="/profilim/basvurularim" class="profile-nav-card">
          <div class="pnc-top">
            <span class="pnc-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            </span>
            <span class="pnc-count mono"><%= typeof myApplicationsCount !== 'undefined' ? myApplicationsCount : 0 %></span>
          </div>
          <h3>Başvurularım</h3>
          <p>Yaptığınız iş başvurularını ve durumlarını görüntüleyin</p>
          <span class="pnc-link">Görüntüle →</span>
        </a>

        <a href="/profilim/ilanlarim" class="profile-nav-card">
          <div class="pnc-top">
            <span class="pnc-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path><rect x="2" y="7" width="20" height="14" rx="2"></rect><path d="M6 11h.01M10 11h.01M14 11h.01"></path></svg>
            </span>
            <span class="pnc-count mono"><%= myJobsCount %></span>
          </div>
          <h3>İlanlarım</h3>
          <p>Oluşturduğunuz iş ilanlarını yönetin</p>
          <span class="pnc-link">Görüntüle →</span>
        </a>

        <a href="/profilim/kaydedilenler" class="profile-nav-card">
          <div class="pnc-top">
            <span class="pnc-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"></rect><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"></path><path d="M14.5 11.5a1.2 1.2 0 0 1 1.2-1.2h2.6a1.2 1.2 0 0 1 1.2 1.2v5.3l-2.5-1.7-2.5 1.7v-5.3z" fill="none" stroke-width="1.5"></path></svg>
            </span>
            <span class="pnc-count mono"><%= savedCount %></span>
          </div>
          <h3>Kaydedilen İlanlar</h3>
          <p>Kaydettiğiniz iş ilanlarını görüntüleyin</p>
          <span class="pnc-link">Görüntüle →</span>
        </a>
      </div>

    </main>
  </div>

  <div id="avatar-overlay" class="avatar-overlay" style="display:none;"></div>
  <div id="avatar-popup" class="avatar-popup" style="display:none;">
    <div class="avatar-popup-inner">
      <img id="avatar-popup-img" src="" alt="" loading="lazy">
    </div>
  </div>

  <!-- Crop Modal -->
  <div id="crop-modal" class="crop-modal" style="display:none;" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="crop-modal-title">
    <div id="crop-modal-backdrop" class="crop-modal-backdrop"></div>
    <div class="crop-modal-content" role="document">
      <div class="crop-modal-header">
        <h3 id="crop-modal-title">Fotoğrafı Kırp</h3>
        <button type="button" id="crop-close" class="crop-close" aria-label="Kapat">&times;</button>
      </div>
      <div class="crop-modal-body">
        <div class="crop-image-wrap">
          <img id="crop-image" src="" alt="Kırpılacak fotoğraf" style="display:block;max-width:100%;">
        </div>
        <div class="crop-zoom-controls">
          <button type="button" id="crop-zoom-out" class="btn btn-ghost btn-sm" aria-label="Uzaklaştır">−</button>
          <span class="crop-zoom-label">Zoom</span>
          <button type="button" id="crop-zoom-in" class="btn btn-ghost btn-sm" aria-label="Yakınlaştır">+</button>
        </div>
        <p class="crop-hint">Kare alan içinde kalacak şekilde sürükleyin ve yakınlaştırın.</p>
        <div id="crop-error" class="field-error" style="text-align:center;min-height:18px;margin-top:8px;"></div>
      </div>
      <div class="crop-modal-actions">
        <button type="button" id="crop-cancel" class="btn btn-ghost">Vazgeç</button>
        <button type="button" id="crop-confirm" class="btn btn-solid">Yükle</button>
      </div>
    </div>
  </div>

  <script src="/vendor/cropper/cropper.min.js"></script>
  <%- include('../partials/footer') %>

</body>
</html>
