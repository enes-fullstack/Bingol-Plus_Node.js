<!DOCTYPE html>
<html lang="tr">
<head>
  <% const _code = typeof statusCode !== "undefined" ? statusCode : 404; %>
  <%- include('../partials/head', { title: _code === 500 ? 'Sunucu Hatası - Bingöl Plus' : 'Sayfa Bulunamadı - Bingöl Plus', description: _code === 500 ? 'Beklenmeyen bir hata oluştu. Bingöl Plus anasayfasına dönerek gezinmeye devam edebilirsiniz.' : 'Aradığınız sayfa bulunamadı. Bingöl Plus anasayfasına dönerek gezinmeye devam edebilirsiniz.' }) %>
  <title><%= _code === 500 ? 'Sunucu Hatası - Bingöl Plus' : 'Sayfa Bulunamadı - Bingöl Plus' %></title>
  <link rel="stylesheet" href="/css/error.css">
</head>
<body>

  <%- include('../partials/navbar') %>

  <div class="error-wrap">
    <%- include('../partials/flash') %>
    <div class="error-code"><%= _code %></div>
    <h1><%= _code === 500 ? 'Sunucu Hatası' : 'Sayfa Bulunamadı' %></h1>
    <p><%= _code === 500 ? 'Beklenmeyen bir hata oluştu. Lütfen daha sonra tekrar deneyin.' : 'Aradığınız sayfa mevcut değil veya taşınmış olabilir.' %></p>
    <a href="/" class="btn btn-solid" style="padding:10px 24px;">Ana Sayfaya Dön</a>
  </div>

  <%- include('../partials/footer') %>

</body>
</html>
