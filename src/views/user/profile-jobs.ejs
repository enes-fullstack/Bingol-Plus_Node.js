<!DOCTYPE html>
<html lang="tr">

<head>
  <%- include('../partials/head', { title: 'İlanlarım - Bingöl Plus', description: 'Bingöl Plus ilanlarım sayfası.' }) %>
  <title>İlanlarım - Bingöl Plus</title>
  <link rel="stylesheet" href="/css/profile.css">
</head>

<body data-user-logged-in="<%= typeof userId !== 'undefined' && userId ? 'true' : 'false' %>">

  <%- include('../partials/navbar', { currentPage: 'profilim' }) %>

  <div class="wrap">
    <%- include('../partials/flash') %>
    <div class="crumb">
      <a href="/">Ana Sayfa</a>
      <span>/</span>
      <a href="/profilim">Profilim</a>
      <span>/</span>
      <span class="mono">İlanlarım</span>
    </div>
    <a href="/profilim" class="top-link">← Profilime Dön</a>

    <main>
      <div class="section">
        <div class="section-head">
          <h2>İlanlarım</h2>
          <span class="count">(<%= typeof jobCount !== 'undefined' ? jobCount : myJobs.length %>)</span>
        </div>

        <% if (myJobs.length > 0) { %>
        <div class="jobs-list" id="myJobs">
          <% myJobs.forEach(job => { %>
          <div class="job-card">
            <span class="pin"></span>
            <div class="job-title"><a href="/ilanlar/<%= job.id %>/<%= slugify(job.title) %>" style="color:inherit;"><%= job.title %></a></div>
            <div class="job-meta">
              <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 21h18M5 21V7l7-4 7 4v14M9 9h1m4 0h1m-6 4h1m4 0h1m-6 4h1m4 0h1" />
                </svg><%= job.company %></span>
              <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0 1 18 0z" />
                  <circle cx="12" cy="10" r="3" />
                </svg><%= job.location %></span>
              <% if (job.salary) { %><span class="salary"><%= job.salary %></span><% } %>
            </div>
            <div class="job-desc"><%= job.description %></div>
            <div class="job-footer">
              <span class="mono"><%= new Date(job.createdAt).toLocaleDateString("tr-TR") %></span>
              <div style="display:flex;gap:8px;margin-left:auto; flex-wrap:wrap; align-items:center;">
                <% const appCount = (typeof applicationCounts !== 'undefined' && applicationCounts[job.id]) ? applicationCounts[job.id] : 0; %>
                <a href="/profilim/ilanlarim/<%= job.id %>/basvurular" class="btn btn-ghost btn-sm" style="<%= appCount > 0 ? 'border-color:var(--lake); color:var(--lake-deep);' : '' %>">
                  Başvurular<% if (appCount > 0) { %> <span style="background:var(--lake); color:#fff; padding:1px 6px; border-radius:999px; font-size:11px; margin-left:4px;"><%= appCount %></span><% } else { %> (0)<% } %>
                </a>
                <a href="/ilanlar/<%= job.id %>/<%= slugify(job.title) %>" class="btn btn-solid btn-sm">Görüntüle</a>
                <form method="POST" action="/ilanlar/sil/<%= job.id %>" data-title="<%= job.title %>" style="display:inline;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-ghost btn-sm job-delete-form" style="color:var(--clay);">Sil</button>
                </form>
              </div>
            </div>
          </div>
          <% }) %>
        </div>
        <% } else { %>
        <div class="empty">Henüz yayınladığınız ilan bulunmuyor. <a href="/ilanlar/ilan-ekle">İlan ekleyin</a>.</div>
        <% } %>

        <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
          <div class="pagination" style="display:flex; justify-content:center; align-items:center; gap:12px; margin-top:24px; font-size:13px;">
            <% if (page > 1) { %>
              <a href="/profilim/ilanlarim?page=<%= page-1 %>" style="color:var(--lake-deep); font-weight:500;">← Önceki</a>
            <% } else { %>
              <span class="disabled" style="color:var(--ink-soft); pointer-events:none;">← Önceki</span>
            <% } %>
            <span>Sayfa <%= page %> / <%= totalPages %></span>
            <% if (page < totalPages) { %>
              <a href="/profilim/ilanlarim?page=<%= page+1 %>" style="color:var(--lake-deep); font-weight:500;">Sonraki →</a>
            <% } else { %>
              <span class="disabled" style="color:var(--ink-soft); pointer-events:none;">Sonraki →</span>
            <% } %>
          </div>
        <% } %>
      </div>
    </main>
  </div>

  <%- include('../partials/footer') %>

</body>
</html>
