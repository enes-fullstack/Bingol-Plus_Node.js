<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Başvuru Durumu</title>
</head>
<body style="margin:0;padding:0;background-color:#f2f1ec;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f2f1ec;padding:24px 0;">
<tr>
<td align="center" style="padding:0 12px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background-color:#ffffff;border:1px solid #e7e5de;border-radius:10px;overflow:hidden;">
<tr>
<td style="padding:28px 28px 0 28px;">
<p style="margin:0;font-family:Arial,Helvetica,sans-serif;font-size:12px;letter-spacing:0.06em;text-transform:uppercase;color:#5b5a4f;">Bingöl Plus</p>
<% if (status === "kabul_edildi") { %>
<h1 style="margin:10px 0 0 0;font-family:Arial,Helvetica,sans-serif;font-size:20px;line-height:1.35;color:#242620;font-weight:700;">Başvurunuz kabul edildi</h1>
<% } else { %>
<h1 style="margin:10px 0 0 0;font-family:Arial,Helvetica,sans-serif;font-size:20px;line-height:1.35;color:#242620;font-weight:700;">Başvurunuz hakkında</h1>
<% } %>
</td>
</tr>
<tr>
<td style="padding:16px 28px 0 28px;">
<% if (status === "kabul_edildi") { %>
<p style="margin:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.65;color:#242620;"><strong><%= title %></strong> başlıklı ilana yaptığınız başvuru <span style="color:#3c763d;font-weight:600;">kabul edildi</span>.</p>
<p style="margin:10px 0 0 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.65;color:#5b5a4f;">İşveren sizinle en kısa sürede iletişime geçecektir.</p>
<% } else { %>
<p style="margin:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.65;color:#242620;"><strong><%= title %></strong> başlıklı ilana yaptığınız başvuru maalesef <span style="color:#a94442;font-weight:600;">reddedildi</span>.</p>
<p style="margin:10px 0 0 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.65;color:#5b5a4f;">Başka ilanlar için başvurularınıza devam edebilirsiniz.</p>
<% } %>
</td>
</tr>
<tr>
<td align="center" style="padding:24px 28px 0 28px;">
<a href="<%= siteUrl %>/profilim/basvurularim" style="display:inline-block;padding:12px 24px;background-color:#1f6b31;color:#ffffff;text-decoration:none;border-radius:8px;font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:600;line-height:1;">Başvurularımı Görüntüle</a>
</td>
</tr>
<tr>
<td style="padding:24px 28px 28px 28px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-top:1px solid #e7e5de;">
<tr><td style="padding-top:16px;">
<p style="margin:0;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.6;color:#9a9993;">Bingöl Plus — Bingöl için yerel ilan ve forum platformu.</p>
</td></tr>
</table>
</td>
</tr>
</table>
</td>
</tr>
</table>
</body>
</html>
