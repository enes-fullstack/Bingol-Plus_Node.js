<!DOCTYPE html>
<html lang="tr">
<head>
  <%- include('../partials/head', { title: 'Loglar - Admin | Bingöl Plus', description: 'Bingöl Plus admin paneli — sistem logları.' }) %>
  <title>Loglar - Admin | Bingöl Plus</title>
  <link rel="stylesheet" href="/css/admin.css">
  <style>
  .filter-bar { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px; }
  .filter-btn { padding: 6px 14px; border: 1px solid var(--stone); border-radius: 20px; font-size: 12.5px; font-weight: 500; background: #fff; color: var(--ink); cursor: pointer; text-decoration: none; transition: all .15s ease; }
  .filter-btn:hover { border-color: var(--lake); color: var(--lake-deep); transform: translateY(-1px); }
  .filter-btn.active { background: var(--lake); color: #fff; border-color: var(--lake); box-shadow: 0 2px 8px rgba(31,107,49,.22); }
  .pagination { display: flex; justify-content: center; align-items: center; gap: 12px; margin-top: 24px; font-size: 13px; }
  .pagination a { color: var(--lake-deep); font-weight: 500; }
  .pagination a:hover { text-decoration: underline; }
  .pagination .disabled { color: var(--ink-soft); pointer-events: none; }

  .log-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    background: #fff;
    border: 1px solid var(--stone-line);
    border-radius: 10px;
    padding: 12px 14px;
    margin-bottom: 16px;
    box-shadow: var(--shadow);
  }
  .log-count { font-size: 13px; color: var(--ink-soft); margin: 0; display: flex; align-items: center; gap: 8px; }
  .log-count::before {
    content: "";
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--lake);
    display: inline-block;
    flex: none;
  }
  .log-pre {
    margin: 0;
    white-space: pre-wrap;
    word-break: break-word;
    overflow-wrap: anywhere;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    line-height: 1.65;
    background: var(--paper-raised);
    border: 1px solid var(--stone-line);
    border-radius: 8px;
    padding: 11px 13px;
    max-height: 280px;
    overflow: auto;
    max-width: 100%;
    display: block;
    box-shadow: inset 0 1px 2px rgba(0,0,0,.04);
  }
  .log-message { max-width: 620px; vertical-align: top; }
  html[data-theme="dark"] .log-pre { background: #1A1E1B; border-color: var(--stone-line); color: var(--ink); }

  /* --- Buttons --- */
  .btn-log-delete-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: .01em;
    border: 1px solid #e5a0a0;
    background: #fff;
    color: #c0392b;
    border-radius: 8px;
    cursor: pointer;
    transition: all .18s ease;
    box-shadow: 0 1px 2px rgba(0,0,0,.06);
    white-space: nowrap;
  }
  .btn-log-delete-all:hover {
    background: #c0392b;
    border-color: #c0392b;
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(192,57,43,.25);
  }
  .btn-log-delete-all:active { transform: translateY(0); box-shadow: 0 1px 2px rgba(0,0,0,.08); }
  .btn-log-delete-all:focus-visible { outline: 2px solid #c0392b; outline-offset: 2px; }

  .btn-log-delete {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 11px;
    font-size: 12px;
    font-weight: 600;
    border: 1px solid #ead0d0;
    background: #fff;
    color: #b94a48;
    border-radius: 7px;
    cursor: pointer;
    transition: all .16s ease;
    white-space: nowrap;
  }
  .btn-log-delete:hover {
    background: #c0392b;
    border-color: #c0392b;
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 3px 10px rgba(192,57,43,.18);
  }
  .btn-log-delete:active { transform: translateY(0); }
  .btn-log-delete:focus-visible { outline: 2px solid #c0392b; outline-offset: 2px; }

  .btn-log-delete svg, .btn-log-delete-all svg { flex: none; opacity: .9; }
  .btn-log-delete:hover svg, .btn-log-delete-all:hover svg { opacity: 1; }

  html[data-theme="dark"] .log-toolbar { background: #1E2320; border-color: var(--stone-line); }
  html[data-theme="dark"] .btn-log-delete { background: #1E2320; border-color: #5a2e2e; color: #ff8a80; }
  html[data-theme="dark"] .btn-log-delete:hover { background: #c0392b; border-color: #c0392b; color: #fff; }
  html[data-theme="dark"] .btn-log-delete-all { background: #1E2320; border-color: #7a2e2e; color: #ff8a80; }
  html[data-theme="dark"] .btn-log-delete-all:hover { background: #c0392b; border-color: #c0392b; color: #fff; }

  @media (max-width: 640px) {
    .log-pre { font-size: 11px; padding: 8px 10px; max-height: 220px; }
    .log-message { max-width: none; }
    .log-toolbar { padding: 10px 12px; }
    .btn-log-delete-all { padding: 7px 12px; font-size: 12px; }
  }
  </style>
</head>
<body>

  <%- include('../partials/navbar', { currentPage: 'admin' }) %>

  <div class="admin-wrap wrap">
    <%- include('../partials/flash') %>
    <a href="/admin" class="top-link">← Admin Paneline Dön</a>
    <div class="admin-head">
      <h1>Sistem Logları</h1>
      <p>Uygulama genelindeki tüm log kayıtları</p>
    </div>

    <div class="filter-bar">
      <a href="/admin/loglar" class="filter-btn <%= !filterType ? 'active' : '' %>">Tümü</a>
      <% ["success","info","warning","error","critical"].forEach(function(t) { %>
        <a href="/admin/loglar?type=<%= t %><%= page > 1 ? '&page='+page : '' %>" class="filter-btn <%= filterType === t ? 'active' : '' %>"><%= t %></a>
      <% }) %>
    </div>

    <div class="log-toolbar">
      <div class="log-count">Toplam <%= logs.length > 0 ? logs.length : '0' %> kayıt <% if (filterType) { %><span style="opacity:.6;">· <%= filterType %></span><% } %></div>
      <% if (logs.length > 0) { %>
        <form method="POST" action="/admin/loglar/sil" onsubmit="return confirm('Tüm logları silmek istediğinize emin misiniz?')" style="margin:0;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn-log-delete-all">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
            Tüm Logları Sil
          </button>
        </form>
      <% } %>
    </div>

    <% if (logs.length > 0) { %>
      <div class="table-wrap">
      <table class="log-table">
        <thead>
          <tr>
            <th>Tür</th>
            <th>Mesaj</th>
            <th style="text-align:right;">Zaman</th>
            <th style="text-align:right;">İşlem</th>
          </tr>
        </thead>
        <tbody>
          <% logs.forEach(function(l) { %>
            <tr>
              <td><span class="log-type log-type-<%= l.type %>"><%= l.type %></span></td>
              <td class="log-message"><pre class="log-pre"><%= l.message %></pre></td>
              <td style="text-align:right;"><span class="log-time"><%= new Date(l.createdAt).toLocaleString("tr-TR", { day:"2-digit", month:"2-digit", year:"numeric", hour:"2-digit", minute:"2-digit" }) %></span></td>
              <td style="text-align:right;">
                <form method="POST" action="/admin/log-sil/<%= l.id %>" onsubmit="return confirm('Bu logu silmek istediğinize emin misiniz?')" style="display:inline;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn-log-delete" title="Bu logu sil">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    Sil
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      </div>

      <% if (totalPages > 1) { %>
        <div class="pagination">
          <% if (page > 1) { %>
            <a href="/admin/loglar?page=<%= page-1 %><%= filterType ? '&type='+filterType : '' %>">← Önceki</a>
          <% } else { %>
            <span class="disabled">← Önceki</span>
          <% } %>
          <span>Sayfa <%= page %> / <%= totalPages %></span>
          <% if (page < totalPages) { %>
            <a href="/admin/loglar?page=<%= page+1 %><%= filterType ? '&type='+filterType : '' %>">Sonraki →</a>
          <% } else { %>
            <span class="disabled">Sonraki →</span>
          <% } %>
        </div>
      <% } %>

    <% } else { %>
      <div class="empty" style="text-align:center;padding:40px 0;">
        <p>Bu kritere uygun log kaydı bulunamadı.</p>
      </div>
    <% } %>
  </div>

  <%- include('../partials/footer') %>

</body>
</html>
