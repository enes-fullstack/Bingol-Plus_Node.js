<!DOCTYPE html>
<html lang="tr">
<head>
  <%- include('../partials/head', { title: 'Şifremi Unuttum - Bingöl Plus', description: 'Bingöl Plus şifre sıfırlama sayfası. Kayıtlı e-posta adresinizi girerek şifrenizi sıfırlayın.' }) %>
  <title>Şifremi Unuttum - Bingöl Plus</title>
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>

  <%- include('../partials/navbar') %>

  <div class="auth-wrap">
    <%- include('../partials/flash') %>
    <div class="auth-card">
      <h1>Şifremi Unuttum</h1>
      <p class="auth-sub">E-posta adresine bir şifre sıfırlama bağlantısı göndereceğiz.</p>

      <form action="/sifremi-unuttum" method="POST" autocomplete="off">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
          <label for="email">E-posta Adresiniz</label>
          <input type="email" id="email" name="email" placeholder="ornek@email.com" value="<%= (locals.flash && locals.flash.oldInput && locals.flash.oldInput.email) ? locals.flash.oldInput.email : '' %>" required>
        </div>

        <button type="submit" class="btn btn-solid auth-btn">Gönder</button>
      </form>

      <div class="auth-alt">
        <a href="/giris-yap">Giriş Yap</a> &middot; <a href="/kayit-ol">Kayıt Ol</a>
      </div>
    </div>
  </div>

  <%- include('../partials/footer') %>

</body>
</html>
