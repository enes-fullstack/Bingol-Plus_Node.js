<!DOCTYPE html>
<html lang="tr">
<head>
  <%- include('../partials/head', { title: 'Şifre Sıfırla - Bingöl Plus', description: 'Bingöl Plus şifre sıfırlama sayfası. Yeni şifrenizi belirleyin.' }) %>
  <title>Şifre Sıfırla - Bingöl Plus</title>
  <meta name="referrer" content="no-referrer">
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>

  <%- include('../partials/navbar') %>

  <div class="auth-wrap">
    <%- include('../partials/flash') %>
    <div class="auth-card">
      <h1>Şifre Sıfırla</h1>
      <p class="auth-sub">Yeni şifreni belirle.</p>

      <form action="/sifre-sifirla/<%= token %>" method="POST" autocomplete="off">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
          <label for="password">Yeni Şifre</label>
          <input type="password" id="password" name="password" placeholder="••••••••" minlength="8" maxlength="100" autocomplete="new-password" required>
        </div>

        <div class="form-group">
          <label for="password-confirm">Yeni Şifre (Tekrar)</label>
          <input type="password" id="password-confirm" placeholder="••••••••" minlength="8" maxlength="100" autocomplete="new-password" required>
          <div id="password-error" style="color:var(--clay);font-size:13px;margin-top:6px;display:none;">Şifreler eşleşmiyor.</div>
        </div>

        <button type="submit" id="submit-btn" class="btn btn-solid auth-btn">Şifreyi Sıfırla</button>
      </form>

      <div class="auth-alt">
        <a href="/giris-yap">Giriş Yap</a>
      </div>
    </div>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
