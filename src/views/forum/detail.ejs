<!DOCTYPE html>
<html lang="tr">

<head>
  <%- include('../partials/head', { title: 'Forum - Bingöl Plus', description: ((post.content || '').replace(/<[^>]*>/g, '').substring(0, 155).trim() || 'Bingöl Plus forum konusu — ' + post.title) }) %>
  <title><%= post.title %> - Forum | Bingöl Plus</title>
  <link rel="stylesheet" href="/css/detail.css">
</head>

<body data-user-logged-in="<%= userId ? 'true' : 'false' %>">

  <%- include('../partials/navbar', { currentPage: 'forum' }) %>

  <main class="wrap">
    <%- include('../partials/flash') %>
    <div class="crumb" style="margin-top:18px;">
      <a href="/forum">Forum</a>
      <span class="sep">/</span>
      <span class="mono"><%= post.PostCategory.name %></span>
    </div>
    <a href="/forum/akis" class="top-link" style="margin-bottom:18px;">← Foruma Dön</a>

    <article class="post-card">
      <% if (post.User && post.User.role === 'admin') { %>
        <span class="creator-badge">Kurucu Tarafından</span>
      <% } else { %>
        <span class="pin"></span>
      <% } %>
      <h1 class="post-title"><%= post.title %></h1>
      <div class="post-meta">
        <span class="cat-tag"><%= post.PostCategory.name %></span>
        <span>·</span>
        <span class="post-author" data-avatar="<%= post.User.profileImage || '' %>">
          <% var pa = avatarMap[post.User.id]; if (pa) { %>
            <img src="<%= pa %>" alt="" class="feed-avatar" loading="lazy">
          <% } else { %>
            <span class="feed-avatar-letter <%= post.User.role === 'admin' ? 'admin-avatar' : '' %>"><%= post.User.username.charAt(0).toUpperCase() %></span>
          <% } %>
          <strong class="<%= post.User.role === 'admin' ? 'admin-username' : '' %>"><%= post.User.username %></strong><% if (post.User.role === 'admin') { %><span class="admin-tick" title="Doğrulanmış Admin" aria-label="Doğrulanmış Admin"><span class="admin-tick-outer" aria-hidden="true"><svg viewBox="0 0 100 100" class="admin-tick-gear" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M98 50 L79.42 55.85 L94.35 68.37 L74.94 66.67 L83.94 83.94 L66.67 74.94 L68.37 94.35 L55.85 79.42 L50 98 L44.15 79.42 L31.63 94.35 L33.33 74.94 L16.06 83.94 L25.06 66.67 L5.65 68.37 L20.58 55.85 L2 50 L20.58 44.15 L5.65 31.63 L25.06 33.33 L16.06 16.06 L33.33 25.06 L31.63 5.65 L44.15 20.58 L50 2 L55.85 20.58 L68.37 5.65 L66.67 25.06 L83.94 16.06 L74.94 33.33 L94.35 31.63 L79.42 44.15 Z"/></svg></span><span class="admin-tick-inner"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M8.2 12.4l2.8 2.8 5.8-5.8" stroke="white" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span></span><% } %>
        </span>
        <span>·</span>
        <span class="mono"><%= new Date(post.createdAt).toLocaleDateString("tr-TR") %></span>
      </div>
      <div class="post-content"><%= post.content %></div>

      <div class="actions">
        <button id="likeBtn" class="action-btn" data-post-id="<%= post.id %>" data-liked="<%= userLiked ? 'true' : 'false' %>">
          <svg id="likeIcon" width="18" height="18" viewBox="0 0 24 24" fill="<%= userLiked ? 'var(--lake-deep)' : 'none' %>" stroke="var(--lake-deep)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
          </svg>
          <span id="likeCount"><%= post.likes || 0 %></span>
        </button>

        <button id="repliesToggleBtn" class="action-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
          </svg>
          <span id="repliesToggleLabel">Yanıtlar (<%= totalReplies %>)</span>
        </button>
      </div>

      <button class="save-post-btn <%= (typeof userSaved !== 'undefined' && userSaved) ? 'saved' : '' %>" data-post-id="<%= post.id %>" aria-label="Kaydet" title="<%= (typeof userSaved !== 'undefined' && userSaved) ? 'Kaydedildi' : 'Kaydet' %>">
        <svg width="16" height="16" viewBox="0 0 24 24" stroke-width="2" fill="<%= (typeof userSaved !== 'undefined' && userSaved) ? 'currentColor' : 'none' %>" stroke="currentColor">
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
        </svg>
      </button>

      <div id="repliesSection" style="display:none;">
        <% if (userId) { %>
        <div id="replyForm" class="reply-form">
          <textarea id="replyContent" rows="3" placeholder="Yanıtınızı yazın..."></textarea>
          <button class="btn btn-solid" id="replySubmitBtn">Gönder</button>
        </div>
        <% } else { %>
        <p class="guest-note"><a href="/giris-yap">Giriş yap</a> veya <a href="/kayit-ol">kayıt ol</a>.</p>
        <% } %>

        <div id="repliesList">
          <% if (replies.length > 0) { %>
          <% replies.forEach(r => { %>
          <div class="reply-item">
            <% var ra = avatarMap[r.User.id]; %>
            <div class="reply-avatar <%= r.User.role === 'admin' ? 'admin-avatar' : '' %>" data-avatar="<%= r.User.profileImage || '' %>">
              <% if (ra) { %>
                <img src="<%= ra %>" alt="" class="reply-avatar-img" style="width:34px;height:34px;" loading="lazy">
              <% } else { %>
                <%= r.User.username.charAt(0).toUpperCase() %>
              <% } %>
            </div>
            <div class="reply-body">
              <div class="reply-head"><strong class="<%= r.User.role === 'admin' ? 'admin-username' : '' %>"><%= r.User.username %></strong><% if (r.User.role === 'admin') { %><span class="admin-tick" title="Doğrulanmış Admin" aria-label="Doğrulanmış Admin"><span class="admin-tick-outer" aria-hidden="true"><svg viewBox="0 0 100 100" class="admin-tick-gear" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M98 50 L79.42 55.85 L94.35 68.37 L74.94 66.67 L83.94 83.94 L66.67 74.94 L68.37 94.35 L55.85 79.42 L50 98 L44.15 79.42 L31.63 94.35 L33.33 74.94 L16.06 83.94 L25.06 66.67 L5.65 68.37 L20.58 55.85 L2 50 L20.58 44.15 L5.65 31.63 L25.06 33.33 L16.06 16.06 L33.33 25.06 L31.63 5.65 L44.15 20.58 L50 2 L55.85 20.58 L68.37 5.65 L66.67 25.06 L83.94 16.06 L74.94 33.33 L94.35 31.63 L79.42 44.15 Z"/></svg></span><span class="admin-tick-inner"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M8.2 12.4l2.8 2.8 5.8-5.8" stroke="white" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span></span><% } %> &middot; <%= new Date(r.createdAt).toLocaleDateString("tr-TR") %></div>
              <div class="reply-text"><%= r.content %></div>
            </div>
          </div>
          <% }) %>
          <% } else { %>
          <p id="noRepliesMsg">Henüz yanıt yok.</p>
          <% } %>
        </div>

        <% if (totalReplies > 10) { %>
        <button id="loadMoreBtn">Daha fazla yanıt</button>
        <% } %>
      </div>

    </article>
  </main>

  <div id="avatar-overlay" class="avatar-overlay" style="display:none;"></div>
  <div id="avatar-popup" class="avatar-popup" style="display:none;">
    <div class="avatar-popup-inner">
      <img id="avatar-popup-img" src="" alt="" loading="lazy">
    </div>
  </div>

  <%- include('../partials/footer') %>

</body>
</html>
