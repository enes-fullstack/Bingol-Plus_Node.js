<!DOCTYPE html>
<html lang="tr">

<head>
  <%- include('../partials/head', { title: 'Forum - Bingöl Plus', description: 'Bingöl Plus forum sayfası. Bingöl hakkında tartışmalar, sorular ve yerel konular.' }) %>
  <title>Bingöl Forumu - Bingöl Plus</title>
  <link rel="stylesheet" href="/css/forum.css">
</head>

<body>

  <%- include('../partials/navbar', { currentPage: 'forum' }) %>

  <div class="wrap">
    <%- include('../partials/flash') %>
    <div class="crumb">
      <a href="/">Ana Sayfa</a>
      <span>/</span>
      <span class="mono">Forum</span>
    </div>
    <a href="/" class="top-link">← Ana Sayfaya Dön</a>

    <div class="forum-hero">
      <h1>Bingöl Forumu</h1>
      <p>Bingöl'de konuşulan konuları keşfet, topluluğa katıl.</p>
    </div>

    <%
      const catDescriptions = {
        "Genel": "Günlük sohbetler, düşünceler ve yaşamdan kesitler.",
        "Soru & Cevap": "Merak ettiklerini sor, bilenlerden cevap al.",
        "Üniversite": "Öğrenci hayatı, dersler ve kampüs gündemi.",
        "İş ve Kariyer": "Bingöl'de iş fırsatları ve kariyer önerileri.",
        "Bingöl Gündemi": "Şehirde olup bitenler, haberler ve etkinlikler.",
        "Alım & Satım": "İkinci el, ilanlar ve alışveriş fırsatları.",
      };
    %>

    <div class="cat-grid">
      <% categories.forEach(cat => { %>
        <% const count = (typeof categoryCountMap !== 'undefined' && categoryCountMap[cat.name] != null) ? categoryCountMap[cat.name] : 0; %>
        <% const desc = catDescriptions[cat.name] || "Bu kategorideki konuları keşfet."; %>
        <% const href = cat.slug ? "/forum/akis/" + cat.slug : "/forum/akis/" + slugify(cat.name); %>
        <a href="<%= href %>" class="cat-card">
          <div class="cat-card-icon" aria-hidden="true">
            <% if (cat.name === "Genel") { %>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            <% } else if (cat.name === "Soru & Cevap") { %>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <% } else if (cat.name === "İş ve Kariyer") { %>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><line x1="12" y1="12" x2="12" y2="12"/></svg>
            <% } else if (cat.name === "Bingöl Gündemi") { %>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2z"/><path d="M8 7h8"/><path d="M8 11h8"/><path d="M8 15h5"/></svg>
            <% } else if (cat.name === "Alım & Satım") { %>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            <% } else if (cat.name === "Üniversite") { %>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6"/><path d="M12 22V10"/><path d="M12 10L2 7l10-5 10 5-10 3z"/></svg>
            <% } else { %>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            <% } %>
          </div>
          <h3 class="cat-card-title"><%= cat.name %></h3>
          <p class="cat-card-desc"><%= desc %></p>
          <span class="cat-card-count"><span class="mono"><%= count %></span> konu &nbsp;→</span>
        </a>
      <% }) %>
    </div>

    <div class="forum-cta">
      <a href="/forum/akis" class="btn btn-ghost">Tüm konuları gör</a>
      <a href="/forum/konu-ac" class="btn btn-solid" style="color:#000">Konu Aç</a>
    </div>
  </div>

  <%- include('../partials/footer') %>

</body>
</html>
